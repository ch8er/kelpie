--- a/.github/workflows/test.yml
+++ b/.github/workflows/test.yml
@@ -2,11 +2,23 @@
 # Runs the test matrix on every change.
 on:
   push:
+    paths-ignore:
+      - 'docs/**'
+      - '**.md'
     branches: [main, 'release/**']
   pull_request:
+    paths-ignore:
+      - 'docs/**'
+      - '**.md'
+    types: [opened, synchronize, reopened, ready_for_review]
+
+concurrency:
+  group: ${{ github.workflow_ref }}-${{ github.event_name }}-${{ (github.event_name == 'pull_request' && contains(fromJSON('["opened","synchronize","reopened"]'), github.event.action) && github.event.pull_request.number) || (github.event_name == 'push' && github.ref != 'refs/heads/main' && github.ref) || github.run_id }}
+  cancel-in-progress: true
 
 jobs:
   test:
+    if: github.event_name != 'pull_request' || github.event.pull_request.draft == false
     runs-on: ubuntu-latest
     steps:
       - uses: actions/checkout@v4
